<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>$(MSBuildThisFileDirectory)OD.Converter\Assets\odconv.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(IncludeAllContentForSelfExtract)' != 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)OD.Converter\tools\ffmpeg.exe;$(MSBuildThisFileDirectory)OD.Converter\tools\ffprobe.exe;$(MSBuildThisFileDirectory)OD.Converter\tools\LICENSE"
             Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest">
      <CopyToPublishDirectory Condition="'$(IncludeAllContentForSelfExtract)' == 'true'">PreserveNewest</CopyToPublishDirectory>
      <CopyToPublishDirectory Condition="'$(IncludeAllContentForSelfExtract)' != 'true'">Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeAllContentForSelfExtract)' != 'true'">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)OD.Converter\tools\ffmpeg.exe;$(MSBuildThisFileDirectory)OD.Converter\tools\ffprobe.exe;$(MSBuildThisFileDirectory)OD.Converter\tools\LICENSE"
                      LogicalName="OD.Converter.FFmpeg.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
